# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect
# Used only by the test suite (a separate database that is wiped between tests)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/campusconnect_test
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
# Comma-separated allowed origins for CORS (leave empty for same-origin only)
CORS_ORIGINS=
# Directory for uploaded files (mount a persistent disk here in production)
UPLOAD_DIR=./uploads
# Set to true when running behind HTTPS proxy (Render, Railway, Heroku, Nginx)
TRUST_PROXY=false
# Allow students to upload notes (they need admin approval)
STUDENT_UPLOADS=true
# Only used by `npm run create-admin` (can also be passed as prompts/args)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
